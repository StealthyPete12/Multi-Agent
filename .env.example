# Event-Driven Multi-Agent Code Review Swarm — environment configuration
#
# Copy this file to `.env` and adjust values for your environment.
# `.env` is gitignored; never commit real credentials.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Prefix used for container names / project namespacing by docker compose.
COMPOSE_PROJECT_NAME=swarm

# development | staging | production — read by shared/logging.py and future
# agent services to switch verbosity / behavior.
ENVIRONMENT=development

# Python logging level used by shared.logging.configure_logging().
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# RabbitMQ (message broker for the event-driven pipeline)
# ---------------------------------------------------------------------------
# AMQP protocol port (client connections).
RABBITMQ_PORT=5672
# Management UI / HTTP API port (http://localhost:15672).
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=swarm
RABBITMQ_PASSWORD=swarm_dev_password
RABBITMQ_VHOST=/
# Full AMQP connection URL, composed from the values above. Agents/services
# should read this single variable rather than reassembling it themselves.
RABBITMQ_URL=amqp://swarm:swarm_dev_password@localhost:5672/

# Durable topic exchange every event is published to. A matching
# "<name>.dlx" topic exchange is declared automatically for dead-lettering.
RABBITMQ_EXCHANGE=swarm.events
# Per-consumer channel QoS (max unacknowledged deliveries at a time).
RABBITMQ_PREFETCH=10

# Queue names, one per consumer stage of the pipeline. Bound to the
# exchange above using the matching shared/contracts.py EventType value
# as the routing key (e.g. q.commits <- "commit.detected").
QUEUE_COMMITS=q.commits
QUEUE_FINDINGS=q.findings
QUEUE_REVIEWS=q.reviews

# ---------------------------------------------------------------------------
# Watcher agent (GitHub webhook receiver)
# ---------------------------------------------------------------------------
# Port the watcher's FastAPI app listens on (uvicorn agents.watcher.main:app).
WATCHER_PORT=8001
# Shared secret configured on the GitHub webhook; used to verify the
# X-Hub-Signature-256 HMAC on every delivery. Generate with e.g.
# `openssl rand -hex 32`. Required — the watcher refuses requests without it.
GITHUB_WEBHOOK_SECRET=changeme_dev_secret
# Comma-separated list of branches to accept push events for; pushes to any
# other branch are acknowledged (200) but ignored.
WATCHED_BRANCHES=main
# Local tunnel URL from `npx smee-client -u https://smee.io/<channel> -t
# http://localhost:${WATCHER_PORT}/webhook/github` — see README for setup.
# Not read by any service; documented here for reference during local dev.
SMEE_URL=

# ---------------------------------------------------------------------------
# Researcher agent (repository cloning, AST analysis, blast radius)
# ---------------------------------------------------------------------------
# Local directory where repositories are cloned/cached, one subdirectory
# per repo slug (e.g. acme/widgets -> <dir>/acme__widgets). Reused across
# commits instead of re-cloning every time.
REPO_CACHE_DIR=/tmp/swarm-repo-cache
# Prefix used to build a clone URL from a bare "org/repo" slug (e.g.
# "acme/widgets" -> "https://github.com/acme/widgets.git"). Ignored if the
# CommitDetected repo value already looks like a URL/local path.
REPO_CLONE_BASE_URL=https://github.com/
# How long (seconds) a cached clone is trusted before the researcher runs
# `git fetch` again to pick up new commits.
REPO_STALE_SECONDS=300
# Max traversal depth (hops through the dependency graph) for blast-radius
# analysis; bounds the recursive CTE against runaway/cyclic graphs.
BLAST_RADIUS_MAX_DEPTH=10
# Comma-separated substrings of a changed file's path that mark it
# "sensitive" (auth/payments/infra/migrations by default).
SENSITIVE_PATH_PATTERNS=auth/,payments/,infra/,migrations/

# ---------------------------------------------------------------------------
# LLM abstraction (shared/llm.py) — summarization (Researcher) and
# narrative generation (Reviewer). The LLM never decides risk scores; see
# agents/reviewer/scoring.py for the deterministic scoring logic.
# ---------------------------------------------------------------------------
# Which provider shared/llm.py::get_llm_client() builds: anthropic | openai
# | ollama | none. "none" (or unset, or a provider missing its required
# credential below) makes every call raise LLMError, which callers catch
# to degrade gracefully (empty semantic_summary, template-based narrative)
# instead of blocking the pipeline on LLM availability.
LLM_PROVIDER=none
# How long (seconds) shared/llm.py waits for a provider response before
# raising LLMError.
LLM_TIMEOUT_SECONDS=30

# Required if LLM_PROVIDER=anthropic. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# Required if LLM_PROVIDER=openai. Get one at https://platform.openai.com/.
OPENAI_API_KEY=
# Required if LLM_PROVIDER=ollama — base URL of a running Ollama server
# (e.g. http://localhost:11434), no API key needed.
OLLAMA_BASE_URL=

# Per-purpose model overrides, comma-separated "purpose=model" pairs.
# Recognized purposes: "summary" (Researcher's small/cheap semantic-summary
# model) and "narrative" (Reviewer's executive-explanation model, allowed
# to be a larger model than "summary"). A purpose not listed here falls
# back to a built-in default for the selected provider.
# Example: MODEL_SELECTIONS=summary=claude-haiku-4-5-20251001,narrative=claude-sonnet-5
MODEL_SELECTIONS=

# ---------------------------------------------------------------------------
# Slack integration (shared/slack.py) — review notifications
# ---------------------------------------------------------------------------
# Incoming Webhook URL (Slack app -> Incoming Webhooks -> Add New Webhook).
# Left empty, SlackNotifier.send() is a no-op that logs and returns success
# — Slack delivery never blocks the pipeline in an environment where no
# webhook has been configured (e.g. local dev/CI).
SLACK_WEBHOOK_URL=
# Base URL used to build the "View Commit" link in a Slack message when no
# true compare_url is available on the wire (see PHASE_3_REPORT.md's Known
# limitations — GitHub's real compare_url isn't threaded through the
# pipeline yet). Same pattern as REPO_CLONE_BASE_URL.
REPO_WEB_BASE_URL=https://github.com/

# ---------------------------------------------------------------------------
# Deterministic risk scoring (agents/reviewer/scoring.py) — thresholds
# only; bucket weights follow the roadmap's suggested values in code.
# ---------------------------------------------------------------------------
# Minimum total score to be classified moderate/high/critical respectively
# (below RISK_SCORE_MODERATE_THRESHOLD is "low").
RISK_SCORE_MODERATE_THRESHOLD=3
RISK_SCORE_HIGH_THRESHOLD=6
RISK_SCORE_CRITICAL_THRESHOLD=10

# ---------------------------------------------------------------------------
# Phase 4: fault tolerance (retry ladder, idempotency, rate limiting,
# circuit breaking, graceful shutdown) — see PHASE_4_REPORT.md.
# ---------------------------------------------------------------------------
# AMQP heartbeat (seconds), lets both sides detect a dead TCP connection
# well before a kernel-level timeout would.
RABBITMQ_HEARTBEAT=60
# Name of the single, shared terminal dead-letter queue (poison messages,
# and retryable failures that exhausted the retry ladder).
QUEUE_DLQ=q.dlq
# Retry ladder rung delays (milliseconds). Defaults match the roadmap's
# 5s -> 30s -> 5m progression; overridable mainly for testing.
RETRY_DELAY_5S_MS=5000
RETRY_DELAY_30S_MS=30000
RETRY_DELAY_5M_MS=300000
# How long (seconds) a consumer gives an in-flight message to finish on
# SIGTERM/SIGINT before force-cancelling it.
GRACEFUL_SHUTDOWN_SECONDS=30
# How long (seconds) a claim (shared/idempotency.py) can sit with no
# mark_complete()/release() before it's treated as abandoned (the
# claiming process crashed) and reclaimed by a later attempt.
IDEMPOTENCY_STALE_CLAIM_SECONDS=300

# LLM retry/backoff (shared/llm.py) — exponential backoff with full
# jitter, applied only to failures classified RetryableError
# (shared/errors.py); a poison/fatal failure never retries.
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_BASE_SECONDS=1.0
LLM_RETRY_BACKOFF_MAX_SECONDS=20.0

# LLM circuit breaker — one breaker per provider, shared by every caller
# in the process. Opens after this many consecutive failures; fails fast
# (no network call) for breaker_open_seconds before a half-open trial.
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_OPEN_SECONDS=60

# LLM rate limiting (shared/ratelimit.py) — Redis-backed distributed
# token bucket, scoped per "<provider>:<model>". Set to false to disable
# (e.g. local dev without Redis); a Redis outage also degrades
# gracefully (logs a warning, proceeds without limiting).
LLM_RATE_LIMIT_ENABLED=true
RATE_LIMIT_TOKENS_PER_MINUTE=60
# Optional per-provider override, e.g. RATE_LIMIT_ANTHROPIC_TPM=100.
RATE_LIMIT_MAX_WAIT_SECONDS=60

# ---------------------------------------------------------------------------
# PostgreSQL (system of record: modules, commits, findings, reports, audit)
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=swarm
POSTGRES_PASSWORD=swarm_dev_password
POSTGRES_DB=code_review_swarm
# Full connection URL composed from the values above.
DATABASE_URL=postgresql://swarm:swarm_dev_password@localhost:5432/code_review_swarm

# ---------------------------------------------------------------------------
# Redis (caching, idempotency locks, ephemeral coordination state)
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=swarm_dev_password
REDIS_URL=redis://:swarm_dev_password@localhost:6379/0

# ---------------------------------------------------------------------------
# Phase 5: observability (shared/telemetry.py) — OpenTelemetry tracing,
# metrics, and the Phoenix/Prometheus/Grafana docker services. See the
# README's "Observability" section and PHASE_5_REPORT.md.
# ---------------------------------------------------------------------------
# otlp_http | otlp_grpc | console | none. otlp_http (the default) ships
# spans to Phoenix's OTLP HTTP collector at OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_TRACES_EXPORTER=otlp_http
# Phoenix's combined UI + OTLP-HTTP collector port. The OTLP HTTP exporter
# appends /v1/traces itself — set only the base URL here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# Only read when OTEL_TRACES_EXPORTER/OTEL_METRICS_EXPORTER=otlp_grpc —
# true (default) since local Phoenix/collectors don't terminate TLS.
OTEL_EXPORTER_OTLP_INSECURE=true
# prometheus (default, exposes a /metrics endpoint via prometheus_client)
# | otlp_http | otlp_grpc | console | none.
OTEL_METRICS_EXPORTER=prometheus
# Bind address/port for the Prometheus exposition endpoint started by
# shared/telemetry.py::init_telemetry() — researcher/reviewer each open
# their own (the watcher mounts /metrics on its existing FastAPI app
# instead, at WATCHER_PORT, so it has no separate metrics port).
OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0
RESEARCHER_METRICS_PORT=9102
REVIEWER_METRICS_PORT=9103

# Ports for the observability docker services (docker-compose.yml).
# Phoenix, Prometheus, and Grafana run with network_mode: host on Linux
# (see README) — the agents are host processes too, so every
# cross-service call in this stack goes through a published localhost
# port rather than the compose bridge network.
PHOENIX_UI_PORT=6006
PHOENIX_GRPC_PORT=4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
POSTGRES_EXPORTER_PORT=9187
# rabbitmq_prometheus plugin (enabled via observability/rabbitmq/enabled_plugins).
RABBITMQ_PROMETHEUS_PORT=15692

# Optional per-model LLM cost overrides (USD per 1M tokens), read by
# shared/telemetry.py::estimate_cost_usd() when a model isn't in its
# built-in PRICING_PER_1M_TOKENS_USD table, or to override a stale price.
# Model name upper-cased, non-alphanumerics -> "_", e.g. for
# "claude-haiku-4-5-20251001":
# LLM_PRICE_CLAUDE_HAIKU_4_5_20251001_IN_PER_1M=1.00
# LLM_PRICE_CLAUDE_HAIKU_4_5_20251001_OUT_PER_1M=5.00
